# Copy to .env and adjust only the values needed on this machine.
# .env is intentionally ignored by Git.

CUDA_VISIBLE_DEVICES=0
MUJOCO_GL=egl
XLA_PYTHON_CLIENT_MEM_FRACTION=0.90
XLA_PYTHON_CLIENT_PREALLOCATE=true

# Relative paths are resolved from the ForceVLA repository root.
OPENPI_DATA_HOME=data/cache/openpi
HF_HOME=data/cache/huggingface

# Start offline; change to online after wandb login if desired.
WANDB_MODE=offline

# Phase-1 defaults
LIBERO_TASK_SUITE=libero_10
FORCEVLA_CONFIG=pi05_libero_lora_4090
FORCEVLA_EXPERIMENT=phase1_pi05_libero_lora
